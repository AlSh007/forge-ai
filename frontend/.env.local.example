# Frontend environment (Next.js). Copy to .env.local for local dev; set the same
# NEXT_PUBLIC_* vars in Vercel for production.

# Backend API base URL
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase (Auth) — Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
