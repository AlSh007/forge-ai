# Backend Environment Variables

PORT=4000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/forgeai_dev

# GitHub Integration
# GITHUB_TOKEN is now an OPTIONAL fallback used only when a user has no per-user
# GitHub token stored (see auth below). In multi-user mode, each user's own OAuth
# token (captured at login, encrypted at rest) is used for their commits.
GITHUB_TOKEN=your_github_token_here
GITHUB_APP_ID=your_app_id_here
GITHUB_APP_SECRET=your_app_secret_here

# Auth (Supabase)
# Project URL — used to fetch the JWKS that verifies Supabase access tokens
# (asymmetric signing keys). Same value as NEXT_PUBLIC_SUPABASE_URL on the frontend.
# Supabase dashboard → Settings → API → Project URL.
SUPABASE_URL=https://your-project.supabase.co
# 32-byte key for encrypting per-user GitHub tokens at rest. Generate with:
#   openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# LLM Provider (Groq — get key from console.groq.com/keys)
GROQ_API_KEY=

# CORS — set to your Vercel frontend URL in production (e.g. https://your-app.vercel.app)
# Leave unset in development to allow all origins.
CORS_ORIGIN=

# Sandbox
DOCKER_HOST=unix:///var/run/docker.sock

# Logging
LOG_LEVEL=debug
